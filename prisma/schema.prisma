// Zinda Hon database schema. PROTOTYPE: every person, CNIC, pension and payment here is fake.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PENSIONER
  HELPER
  SHOPKEEPER
  OFFICER
  ADMIN
  AUDITOR
}

enum CaseStatus {
  DUE
  IN_PROGRESS
  NEEDS_PROOF
  WITH_OFFICER
  VERIFIED
  STOPPED
}

enum Outcome {
  APPROVE
  ASK_MORE_PROOF
  SEND_TO_OFFICER
  OFFICER_APPROVED
  OFFICER_STOPPED
}

enum ActorType {
  USER
  AI
  AGENT
  SYSTEM
  API_CLIENT
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  nameUr    String
  plan      String   @default("free")
  createdAt DateTime @default(now())

  users       User[]
  pensioners  Pensioner[]
  cases       Case[]
  ruleVersions RuleVersion[]
  apiKeys     ApiKey[]
}

model User {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  role              Role
  name              String
  phone             String   @unique
  passwordHash      String
  pinHash           String? // 4-digit PIN, the backup login for pensioners when the face check fails
  preferredLanguage String   @default("ur")
  area              String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  pensioner      Pensioner?
  helperLinks    HelperLink[]
  assignedCases  Case[]       @relation("AssignedOfficer")
  checkedMessages CheckedMessage[]

  @@index([tenantId, role])
}

model Pensioner {
  id                     String    @id @default(cuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  userId                 String?   @unique
  user                   User?     @relation(fields: [userId], references: [id])
  pensionNo              String    @unique
  cnicMock               String?
  name                   String
  nameUr                 String?
  nameNormalized         String
  fatherOrHusbandName    String?
  dateOfBirth            DateTime?
  pensionType            String // "family" (widow) or "self"
  monthlyAmount          Int
  bankAccountNo          String?
  area                   String?
  enrolledFaceDescriptor Float[] // 128 numbers from face-api, never the photo itself
  faceSource             String? // "nadra" (fetched with her consent) or "office" (fallback enrolment)
  status                 String    @default("active") // active, suspended, stopped
  createdAt              DateTime  @default(now())

  cases       Case[]
  helperLinks HelperLink[]
  consents    Consent[]
  corrections DataCorrectionRequest[]

  @@index([tenantId])
  @@index([cnicMock])
}

model HelperLink {
  id          String    @id @default(cuid())
  helperId    String
  helper      User      @relation(fields: [helperId], references: [id])
  pensionerId String
  pensioner   Pensioner @relation(fields: [pensionerId], references: [id])
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([helperId, pensionerId])
}

model Case {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  pensionerId      String
  pensioner        Pensioner  @relation(fields: [pensionerId], references: [id])
  year             Int
  status           CaseStatus @default(DUE)
  assignedOfficerId String?
  assignedOfficer  User?      @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  priority         Int        @default(0) // higher = more urgent
  confidence       Float?
  riskFlags        String[]
  officerNotes     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  closedAt         DateTime?

  steps     CaseStep[]
  agentRuns AgentRun[]
  evidence  Evidence[]
  decisions Decision[]

  @@unique([pensionerId, year])
  @@index([tenantId, status])
}

model CaseStep {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id])
  step           String // voice_intro, selfie, liveness, document, review
  result         String
  clientActionId String   @unique // generated on the phone; stops duplicate syncs
  createdAt      DateTime @default(now())
}

model Evidence {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  type      String // face_match, liveness, document_qr, document_ocr
  score     Float?
  passed    Boolean?
  details   Json
  createdAt DateTime @default(now())

  @@index([caseId, type])
}

model Decision {
  id            String      @id @default(cuid())
  caseId        String
  case          Case        @relation(fields: [caseId], references: [id])
  outcome       Outcome
  confidence    Float
  ruleVersionId String
  ruleVersion   RuleVersion @relation(fields: [ruleVersionId], references: [id])
  modelName     String? // which AI model wrote the explanation, if any
  inputs        Json
  checkScores   Json
  reasonUr      String
  reasonEn      String
  auditTrace    Json
  decidedBy     String // "ai" or the officer's user id
  createdAt     DateTime    @default(now())

  @@index([caseId])
}

model RuleVersion {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  ruleKey    String // e.g. "proof_of_life"
  version    Int
  config     Json // thresholds and costs, edited by admin without code changes
  note       String?
  createdBy  String
  activeFrom DateTime   @default(now())
  createdAt  DateTime   @default(now())

  decisions Decision[]

  @@unique([tenantId, ruleKey, version])
}

model Consent {
  id          String    @id @default(cuid())
  pensionerId String
  pensioner   Pensioner @relation(fields: [pensionerId], references: [id])
  granteeType String // helper, bank, department
  granteeId   String
  granteeName String
  fields      String[] // e.g. name, cnic, face, bank_account
  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?

  @@index([pensionerId])
  @@index([granteeId])
}

model DataCorrectionRequest {
  id          String    @id @default(cuid())
  pensionerId String
  pensioner   Pensioner @relation(fields: [pensionerId], references: [id])
  field       String
  oldValue    String?
  newValue    String
  status      String    @default("pending") // pending, accepted, rejected
  requestedBy String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model CheckedMessage {
  id            String   @id @default(cuid())
  tenantId      String
  submittedById String?
  submittedBy   User?    @relation(fields: [submittedById], references: [id])
  text          String
  sender        String?
  area          String?
  label         String // scam, genuine, unsure
  confidence    Float
  reasons       Json
  route         String // warn_user, ask_more, human_review
  reviewedLabel String? // set by an officer; used for honest accuracy numbers
  modelName     String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  tenantId   String?
  actorType  ActorType
  actorId    String?
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([targetType, targetId])
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  prefix     String    @unique
  keyHash    String
  scopes     String[]
  rateLimit  Int       @default(60) // requests per minute
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  channel   String   @default("in_app") // in_app, sms_mock
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ---------- Mock government and bank services (deliberately messy data) ----------

model MockNadraRecord {
  id           String    @id @default(cuid())
  cnic         String?
  name         String
  nameUr       String?
  fatherOrHusbandName String?
  dateOfBirth  DateTime?
  address      String?
  maritalStatus String?
  // Simulated CNIC photo, kept only as the 128-number face print (never the photo itself).
  faceDescriptor Float[] @default([])
  photoTakenAt  DateTime?
}

model MockBankAccount {
  id           String    @id @default(cuid())
  accountNo    String    @unique
  holderName   String
  cnic         String?
  lastActivity DateTime?
  withdrawalsLast90Days Int @default(0)
}

model MockDeathRecord {
  id          String   @id @default(cuid())
  cnic        String?
  name        String
  dateOfDeath DateTime
  registeredAt String
}

// One investigation by the officer's AI case assistant (an agent that calls read-only tools).
// It only advises: it can never approve, stop or change a case.
model AgentRun {
  id          String   @id @default(cuid())
  tenantId    String
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  startedById String
  mode        String // "ai" (model chose the steps) or "checklist" (AI not available: fixed steps)
  model       String?
  status      String   @default("running") // running, done, failed
  steps       Json     @default("[]")
  report      Json?
  ms          Int?
  createdAt   DateTime @default(now())

  @@index([caseId, createdAt])
}

// Errors from the server and from people's phones, kept in our own database so the admin can see
// what broke without opening the hosting logs. Messages are cut short and never hold form data.
model ErrorEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  source    String // "server" or "client"
  route     String?
  message   String
  stack     String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A rule change that makes the checks looser (for example a higher face distance or a lower required
// confidence) waits here until a second, different admin approves it. Tighter changes apply at once.
model RuleChangeRequest {
  id          String    @id @default(cuid())
  tenantId    String
  baseVersion Int // the active version it was proposed against
  config      Json
  note        String?
  loosened    String[]
  proposedBy  String
  status      String    @default("pending") // pending, approved, rejected, cancelled
  decidedBy   String?
  decidedNote String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, status])
}

// A new person asking for an account. Nothing is created until a pension officer has checked them
// against the mock NADRA record (and, for a pensioner, the pension record), so nobody can sign up as
// someone else. Only mock CNICs (starting 00000) and mock phone numbers are accepted.
model Registration {
  id           String    @id @default(cuid())
  tenantId     String
  role         String // PENSIONER, HELPER or SHOPKEEPER
  name         String
  cnic         String
  phone        String
  dateOfBirth  DateTime?
  area         String?
  pensionNo    String?
  passwordHash String
  pinHash      String?
  checks       Json // what the automatic checks found, shown to the officer
  details      Json? // role-specific answers: a widow's husband and death certificate, a shop's name and address
  assistedBy   Json? // when someone else filled the form for her: their name, mock phone and relation
  status       String    @default("pending") // pending, approved, rejected
  decidedBy    String?
  decidedNote  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, status])
  @@index([phone])
}
