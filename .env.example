# Copy to .env for local development. On Vercel, set these in Project Settings -> Environment Variables.
# Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL = the pooled connection (port 6543, add ?pgbouncer=true)
# DIRECT_URL   = the direct connection (port 5432), used for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Long random string used to sign login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=""
# Signs the QR code on mock pension books. Generate one with: openssl rand -hex 32
QR_SIGNING_SECRET=""
# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=""
# Groq API key (speech to text)
GROQ_API_KEY=""
# Azure Speech (text to speech)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
